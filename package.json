    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest",
    "submit:all": "eas submit --platform all --latest",
    "release:ios": "eas build --profile production --platform ios --auto-submit",
    "release:android": "eas build --profile production --platform android --auto-submit",
    "update": "eas update",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production",
    "credentials:ios": "eas credentials --platform ios",
    "credentials:android": "eas credentials --platform android",
    "doctor": "npx expo-doctor",
